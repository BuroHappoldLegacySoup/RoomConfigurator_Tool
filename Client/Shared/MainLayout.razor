    <MudDrawer Class="mt-4" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
        <MudLink Href="https://bhom.xyz/" Target="_blank" Class="mt-auto mb-5 ml-2">Powered by BHoM</MudLink>
    </MudDrawer>
    <MudMainContent Class="mt-4">
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>

        <MudOverlay Visible="@(SharedData.GlobalMessage.Length > 0)" DarkBackground="true" ZIndex="9999">
            <MudContainer Class="d-flex flex-column align-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Class="mb-5" Indeterminate="true" />
                <MudText Typo="Typo.h5" Style="color: white;">@SharedData.GlobalMessage</MudText>
            </MudContainer>
        </MudOverlay>
    </MudMainContent>
